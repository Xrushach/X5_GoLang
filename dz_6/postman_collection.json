{
  "info": {
    "name": "Урок 8. Сервис заказов",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://127.0.0.1:8080"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/health"
      }
    },
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"customer\":\"Анна\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get order 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/orders/1"
      }
    },
    {
      "name": "Missing order",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/orders/999"
      }
    },
    {
      "name": "Empty customer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"customer\":\" \"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Two JSON values",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\"customer\":\"Анна\"} {}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Wrong method",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base}}/orders/1"
      }
    },
    {
      "name": "HEAD",
      "request": {
        "method": "HEAD",
        "header": [],
        "url": "{{base}}/health"
      }
    },
    {
      "name": "Demo panic",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base}}/demo/panic"
      }
    }
  ]
}
